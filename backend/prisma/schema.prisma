generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id @default(uuid()) @db.Uuid
  email                 String         @unique
  passwordHash          String
  fullName              String
  role                  Role           @default(EMPLOYEE)
  status                UserStatus     @default(ACTIVE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  employee              Employee?
  refreshTokens         RefreshToken[]
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveRequestReviewer")
  assignedLeaveRequests LeaveRequest[] @relation("LeaveRequestApprover")
  notifications         Notification[]
  reviewedAttendanceAdjustments AttendanceAdjustmentRequest[] @relation("AttendanceAdjustmentReviewer")
  createdWorkSchedules WorkScheduleVersion[] @relation("WorkScheduleCreator")
  updatedWorkSchedules WorkScheduleVersion[] @relation("WorkScheduleUpdater")
  workScheduleAudits WorkScheduleAudit[]
}

model WorkScheduleVersion {
  id               String @id @default(uuid()) @db.Uuid
  version          Int @unique @default(autoincrement())
  revision         Int @default(1)
  status           WorkScheduleStatus @default(DRAFT)
  effectiveFrom    DateTime @db.Date
  timezone         String
  weekdays         Int[]
  startMinute      Int
  endMinute        Int
  breakStartMinute Int
  breakEndMinute   Int
  createdBy        String @db.Uuid
  updatedBy        String @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  creator          User @relation("WorkScheduleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater          User @relation("WorkScheduleUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  audits           WorkScheduleAudit[]

  @@index([status, version])
}

model WorkScheduleAudit {
  id                String @id @default(uuid()) @db.Uuid
  scheduleVersionId String @db.Uuid
  action            WorkScheduleAuditAction
  before            Json?
  after             Json
  actorId           String @db.Uuid
  createdAt         DateTime @default(now())
  scheduleVersion   WorkScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Restrict)
  actor             User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([scheduleVersionId, createdAt])
}

enum WorkScheduleStatus {
  DRAFT
  ACTIVE
}

enum WorkScheduleAuditAction {
  CREATE
  UPDATE
}

model Employee {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String?        @unique @db.Uuid
  employeeCode  String         @unique
  fullName      String
  email         String         @unique
  phone         String
  gender        Gender
  dateOfBirth   DateTime
  position      String
  departmentId  String?        @db.Uuid
  status        EmployeeStatus @default(ACTIVE)
  joinedAt      DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  department    Department?    @relation(fields: [departmentId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  leaveRequests LeaveRequest[]
  attendances   Attendance[]
  attendanceAdjustments AttendanceAdjustmentRequest[]
  payrolls      Payroll[]

  @@index([email])
  @@index([employeeCode])
  @@index([departmentId])
  @@index([status, createdAt])
}

model Department {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  employees   Employee[]

  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LeaveRequest {
  id         String             @id @default(uuid()) @db.Uuid
  employeeId String             @db.Uuid
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveRequestStatus @default(PENDING)
  approverId String?            @db.Uuid
  reviewedBy String?            @db.Uuid
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  approver User?    @relation("LeaveRequestApprover", fields: [approverId], references: [id], onDelete: SetNull)
  reviewer User?    @relation("LeaveRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([startDate])
  @@index([endDate])
  @@index([approverId, status])
  @@index([reviewedBy])
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  employeeId     String           @db.Uuid
  attendanceDate DateTime         @db.Date
  checkInTime    DateTime
  checkOutTime   DateTime?
  status         AttendanceStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  adjustmentRequests AttendanceAdjustmentRequest[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([status, attendanceDate])
  @@index([employeeId, attendanceDate])
}

model AttendanceAdjustmentRequest {
  id                    String                     @id @default(uuid()) @db.Uuid
  employeeId            String                     @db.Uuid
  attendanceId          String?                    @db.Uuid
  attendanceDate        DateTime                   @db.Date
  originalCheckInTime   DateTime?
  originalCheckOutTime  DateTime?
  originalUpdatedAt     DateTime?
  requestedCheckInTime  DateTime
  requestedCheckOutTime DateTime?
  reason                String
  status                AttendanceAdjustmentStatus @default(PENDING)
  reviewedBy            String?                    @db.Uuid
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  employee   Employee    @relation(fields: [employeeId], references: [id])
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  reviewer   User?       @relation("AttendanceAdjustmentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([employeeId, attendanceDate])
  @@index([attendanceId])
  @@index([status, createdAt])
  @@index([reviewedBy])
}

model Payroll {
  id          String        @id @default(uuid()) @db.Uuid
  employeeId  String        @db.Uuid
  month       Int
  year        Int
  baseSalary  Decimal       @db.Decimal(12, 2)
  bonus       Decimal       @default(0) @db.Decimal(12, 2)
  deduction   Decimal       @default(0) @db.Decimal(12, 2)
  netSalary   Decimal       @db.Decimal(12, 2)
  note        String?
  status      PayrollStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@index([status])
}

model Notification {
  id         String                   @id @default(uuid()) @db.Uuid
  userId     String                   @db.Uuid
  type       NotificationType
  title      String
  message    String
  entityType NotificationEntityType
  entityId   String                   @db.Uuid
  isRead     Boolean                  @default(false)
  createdAt  DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  LATE
}

enum AttendanceAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum NotificationType {
  ATTENDANCE_ADJUSTMENT_CREATED
  LEAVE_REQUEST_CREATED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  LEAVE_REQUEST_ASSIGNED
}

enum NotificationEntityType {
  ATTENDANCE_ADJUSTMENT
  LEAVE_REQUEST
}
